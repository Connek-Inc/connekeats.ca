# Connek Food — reverse proxy con HTTPS AUTOMÁTICO (Let's Encrypt).
# El frontend llama a /api en el MISMO origen; el servidor Next reenvía /api/* al
# contenedor api (red interna). Por eso Caddy solo necesita el dominio del front;
# el backend NO se expone a internet.
#
# Requisitos: DNS de connekeats.ca y www → IP del VPS, + puertos 80/443 abiertos.

connekeats.ca, www.connekeats.ca {
	encode gzip zstd
	reverse_proxy web:3000
}
