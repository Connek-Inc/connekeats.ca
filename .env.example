# ── Frontend (Next.js) — variables PÚBLICAS (se hornean en el build) ──
# Copia este archivo a .env.local y rellena los valores reales.
# NOTA: todo lo que empieza con NEXT_PUBLIC_ es público (va al navegador).

# URL pública del backend FastAPI. En el VPS detrás de Caddy puede ser el dominio
# (p. ej. https://connekeats.ca/api o https://api.connekeats.ca).
NEXT_PUBLIC_API_URL=https://api.connekeats.ca

# Supabase del proyecto. La ANON key es pública por diseño (no es secreta).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx_o_anon_key
